{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Get My TG",
  "colors": {
    "primary": "#3B6EC8",
    "light": "#5B8EE8",
    "dark": "#2B5EB8"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "ru",
        "tabs": [
          {
            "tab": "Документация",
            "groups": [
              {
                "group": "Начало работы",
                "pages": [
                  "ru/index",
                  "ru/getting-started/overview",
                  "ru/getting-started/first-steps",
                  "ru/getting-started/supported-clients",
                  "ru/faq"
                ]
              },
              {
                "group": "Аккаунты",
                "pages": [
                  "ru/accounts/structure",
                  "ru/accounts/sessions",
                  "ru/accounts/env",
                  "ru/accounts/app-id",
                  "ru/accounts/limits"
                ]
              },
              {
                "group": "Сеть",
                "pages": [
                  "ru/network/overview",
                  "ru/network/proxy",
                  "ru/network/vpn"
                ]
              },
              {
                "group": "Разработчикам",
                "pages": [
                  "ru/sdk"
                ]
              },
              {
                "group": "Справочник",
                "pages": [
                  "ru/security/overview",
                  "ru/issues/troubleshooting",
                  "ru/glossary"
                ]
              }
            ]
          },
          {
            "tab": "API",
            "openapi": {
              "source": "https://app.stainless.com/api/spec/documented/gmt/openapi.documented.yml",
              "directory": "sdk-reference"
            }
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "en/index",
                  "en/getting-started/overview",
                  "en/getting-started/first-steps",
                  "en/getting-started/supported-clients",
                  "en/faq"
                ]
              },
              {
                "group": "Accounts",
                "pages": [
                  "en/accounts/structure",
                  "en/accounts/sessions",
                  "en/accounts/env",
                  "en/accounts/app-id",
                  "en/accounts/limits"
                ]
              },
              {
                "group": "Network",
                "pages": [
                  "en/network/overview",
                  "en/network/proxy",
                  "en/network/vpn"
                ]
              },
              {
                "group": "Developers",
                "pages": [
                  "en/sdk"
                ]
              },
              {
                "group": "Reference",
                "pages": [
                  "en/security/overview",
                  "en/issues/troubleshooting",
                  "en/glossary"
                ]
              }
            ]
          },
          {
            "tab": "API",
            "openapi": {
              "source": "https://app.stainless.com/api/spec/documented/gmt/openapi.documented.yml",
              "directory": "sdk-reference"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Main Bot",
          "href": "https://t.me/GetMyTGrobot",
          "icon": "bot"
        },
        {
          "anchor": "Contact Support",
          "href": "https://t.me/GetMyTGSUPbot",
          "icon": "message-circle"
        },
        {
          "anchor": "OpenAPI (JSON)",
          "href": "https://api.getmytg.com/docs/openapi.json",
          "icon": "download"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/cameo6",
      "telegram": "https://t.me/GetMyTGrobot"
    }
  }
}
